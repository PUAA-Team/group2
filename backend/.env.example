# 参数示例，配置通过进程环境传入；应用不会自动加载此文件。
MT_RUNTIME_DIR=D:/model-training-demo/backend-runtime
MT_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MT_LOCAL_CONTROLLER_URL=http://127.0.0.1:8000
MT_ENABLE_LOCAL_WORKER=1
MT_ALLOW_BROWSER_SETUP=0
MT_SECURE_COOKIE=0
MT_LLM_PYTHON=D:/model-training-demo/worker-llm-runtime/.venv/Scripts/python.exe
MT_MODEL_CACHE=D:/model-training-demo/worker-llm-runtime/cache/huggingface
# Linux正式部署另行核对PostgreSQL、HTTPS、绝对路径与进程托管。
