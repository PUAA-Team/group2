[Unit]
Description=Renew model platform IP certificate
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
# 从部署 .env 读 TLS_IP（证书目录名）；文件不存在时不硬失败，
# 续期脚本会在地址为空时明确报错。
EnvironmentFile=-/srv/model-platform/current/deploy/server/.env
ExecStart=/usr/bin/python3 /srv/model-platform/ops/renew_certificate.py --root /srv/model-platform --ip ${TLS_IP}
TimeoutStartSec=300
