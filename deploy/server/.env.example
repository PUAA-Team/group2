RELEASE_ID=replace-with-release-id
RUNTIME_DIR=/srv/model-platform/runtime
PUBLIC_PORT=5488
PUBLIC_BIND_ADDRESS=0.0.0.0
# 公网入口主机（IP 或域名），与 TLS_IP 通常相同；换服务器时一起改。
PUBLIC_HOST=8.152.206.86
# 证书目录名：certbot 在 certificates/live/<TLS_IP>/ 下存放证书；
# 网关模板与续期脚本都读这个值，旧 IP 不再写死在配置里。
TLS_IP=8.152.206.86
# 根据确认的入口协议一起配置来源、Cookie与网关文件。
MT_PUBLIC_ORIGIN=https://8.152.206.86:5488
MT_SECURE_COOKIE=1
GATEWAY_CONFIG=./nginx-https.conf.template
# 由部署者生成不同的随机口令，私有.env限制为0600，不纳入发布包。
POSTGRES_PASSWORD=
MT_DATABASE_PASSWORD=
