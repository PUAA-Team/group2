# 由官方 nginx 镜像入口在容器启动时经 envsubst 渲染：
# ${TLS_IP} 取自网关容器的同名环境变量（compose 从 .env 传入）；
# 模板里的 $http_host 等 nginx 变量不在环境变量表里，不会被替换。
server {
    listen 8080 ssl;
    server_name _;
    server_tokens off;
    access_log off;
    client_max_body_size 65m;
    ssl_certificate /etc/letsencrypt/live/${TLS_IP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_IP}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # 安全响应头（与 nginx-http.conf.template 保持同步，HSTS 仅 HTTPS）：
    # nosniff 防 MIME 嗅探；DENY 禁止一切 framing；Referrer-Policy 默认；
    # CSP 只放行同源脚本/连接与同源样式。前端 JS 模板里有少量 style="..."
    # 行内样式（如图表图例），故 style-src 保留 'unsafe-inline'；
    # 后续把这几处行内样式迁到 CSS 类后可收紧，见 stage20b-1 验收文档。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
}
